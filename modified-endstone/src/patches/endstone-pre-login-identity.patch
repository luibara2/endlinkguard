+// limitations under the License.
+
+#pragma once
+
+#include <string>
+#include <utility>
+
+#include "endstone/event/cancellable.h"
+#include "endstone/event/server/server_event.h"
+#include "endstone/util/socket_address.h"
+
+namespace endstone {
+
+/**
+ * @brief Called after BDS validates a LoginPacket but before it loads player data.
+ *
+ * A trusted proxy plugin may replace xuid and unique_id here. The values are
+ * copied back into PlayerAuthenticationInfo before BDS constructs
+ * PlayerStorageIds, allowing the native XUID-backed record to be selected.
+ */
+class PlayerPreLoginEvent : public Cancellable<ServerEvent> {
+public:
+    ENDSTONE_EVENT(PlayerPreLoginEvent);
+    PlayerPreLoginEvent(std::string name, std::string xuid, std::string unique_id, SocketAddress address,
+                        std::string message = "")
+        : Cancellable(false), name_(std::move(name)), xuid_(std::move(xuid)), unique_id_(std::move(unique_id)),
+          address_(std::move(address)), message_(std::move(message))
+    {
+    }
+    ~PlayerPreLoginEvent() override = default;
+
+    [[nodiscard]] const std::string &getName() const { return name_; }
+
+    [[nodiscard]] const std::string &getXuid() const { return xuid_; }
+    void setXuid(std::string xuid) { xuid_ = std::move(xuid); }
+
+    [[nodiscard]] const std::string &getUniqueId() const { return unique_id_; }
+    void setUniqueId(std::string unique_id) { unique_id_ = std::move(unique_id); }
+
+    [[nodiscard]] SocketAddress getAddress() const { return address_; }
+
+    [[nodiscard]] const std::string &getKickMessage() const { return message_; }
+    void setKickMessage(std::string message) { message_ = std::move(message); }
+
+private:
+    std::string name_;
+    std::string xuid_;
+    std::string unique_id_;
+    SocketAddress address_;
+    std::string message_;
+};
+
+}  // namespace endstone
